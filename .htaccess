# ============================================================
#  D.A.V.E. Website – Server-Einstellungen für Hostinger (LiteSpeed/Apache)
# ============================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------- HTTPS + ohne "www" erzwingen ----------
# Hostinger aktiviert das kostenlose SSL-Zertifikat automatisch. Falls die Seite direkt
# nach dem Hochladen nicht lädt ("zu viele Weiterleitungen"), SSL in hPanel prüfen.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# ---------- Sicherheits-Header ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Nach erfolgreichem HTTPS-Test einkommentieren:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------- Komprimierung ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---------- Browser-Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
AddType font/woff2 .woff2

# Versteckte/interne Dateien schützen
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
